#!/usr/bin/env python3
"""
SCons build file for atlas georeferencing workflow.

Converting raw tiff scans to smaller jpgs and generating pdf.

Watches tie point files and regenerates georeferenced maps when they change.
Also builds per-map and master BibTeX files.

v. 0.8.1
Tobias Staal 2026

Changes in 0.8.0
----------------
* Zip archiving removed entirely. The subsection archives, the 'zip' alias
  and the zip_raw option are gone; archiving for publication is now done by
  the separate Zenodo upload script, which compresses one zip per chapter
  into its own staging directory and leaves the working tree untouched.
* The compiled volume PDFs are now COLOUR instead of bitonal grey.
  - Per-page rendering keeps sRGB: '-colorspace gray' and '-normalize' are
    gone (per-page normalize also shifted colours from sheet to sheet), as
    are '-morphology Close' and '-sharpen', which were bitonal cleanup
    steps that add JPEG noise and file size on colour scans.
  - Size is held down by chroma subsampling (4:2:0), '-strip', and an
    explicit Ghostscript downsample to PDF_MERGE_DPI at PDF_MERGE_JPEG_QUALITY
    rather than relying on the '/ebook' preset alone. On test plates the
    colour volume at 150 dpi came out ~20% SMALLER than the old grey one
    (0.46 vs 0.58 MB per page); 200 dpi costs about 0.76 MB per page.
  - All of it is tunable from the PDF OUTPUT SETTINGS block below; set
    PDF_COLOUR = False to get the old grey behaviour back.
* Page PDFs now live in export/pdf_color/ rather than export/pdf_bw/. The
  old directories can be deleted; every page is re-rendered once because the
  ImageMagick arguments are part of each target's signature.

Changes in 0.7.2
----------------
* Editing one spreadsheet cell no longer rebuilds every map. Individual
  targets previously depended on the whole workbook, so any change to
  atlas_master.xlsx invalidated all 497 georeferencing tasks, all per-map
  .bib files and all archives. Each target now depends only on what it
  actually consumes: tie points and raw scan (plus Target crs and Scale via
  the action varlist) for a map, the rendered entry for a .bib, and its own
  members for an archive. Only the master .bib still reads the workbook.

Changes in 0.7.1
----------------
* ImageMagick and Ghostscript now run through Python function actions with
  explicit argv lists. SCons splits command *strings* on whitespace when
  building argv, which quoting does not prevent, so the space in
  'LZW compression TIFF/...' made ImageMagick fail with
  "no decode delegate for this image format `LZW'".
* Subsection archives were taken out of the default build (they are
  multi-GB). Removed altogether in 0.8.0.

Changes in 0.7.0
----------------
* Tie point layer is selected explicitly ('tie_points' preferred), so
  QGIS GPKGs carrying a 'layer_styles' table no longer emit a
  'More than one layer found' warning or depend on layer order.
* Sparse tie point sets no longer abort the build: 3+ points fit an affine,
  2 points fit a conformal similarity (scale + rotation + translation),
  1 point fits a translation keeping the source scale and rotation. The
  transform actually used is named in the log.
* Quality grading is scale-aware. Residuals are also reported in millimetres
  on the printed sheet using the Scale column, graded against the 0.5 mm
  plotting convention, instead of fixed metre thresholds that are
  meaningless from 1:2,000 to 1:180,000,000.
* Logs report the worst point and the RMSE excluding it, so a single
  mistyped lon/lat is easy to spot.

Changes in 0.6.0
----------------
* Volume is now an explicit constant (ATLAS_VOLUME); the old heuristic
  ("'II' in raw_path") mis-tagged 193 rows because Map Index uses Roman
  numerals in filenames such as P_7_II.tiff.
* volume_I.csv / volume_II.csv are optional. A missing or malformed file
  warns and skips only that compiled PDF instead of aborting the build.
* Georeferencing no longer assumes the raw raster's transform is in the
  target CRS. Pixel lookup uses SOURCE_CRS (3031); the output is written
  in Target crs. A mismatch with src.crs is logged as a WARNING.
* Tie point layers are checked for a CRS and for lon/lat columns, and are
  reprojected to EPSG:4326 when needed.
* BibTeX keys are ASCII-folded and stripped of parentheses; duplicate keys
  are disambiguated. Field values escape a fuller set of TeX specials.
* Degrees of freedom reported as 2n-6 (affine on n points).
* Builders declare varlist so BIB_ENTRY / TARGET_CRS changes are part of
  the target signature.
* Paths with spaces are quoted in magick command lines.
* Rasters are copied band-by-band with BIGTIFF=IF_SAFER; outputs are
  written to a temporary file and renamed, so a failed build never leaves
  a truncated target.
* NEW: one zip archive per subsection directory, written beside it.
  (Removed again in 0.8.0.)

# To add:
# Run rsync to get scans
# Update georef in spreadsheet
"""
import os
import re
import csv
import shutil
import subprocess
import unicodedata
from pathlib import Path
from datetime import datetime

import numpy as np
import pandas as pd
import geopandas as gpd
import rasterio
from rasterio.control import GroundControlPoint
from rasterio.transform import from_gcps
from affine import Affine
import pyproj
from pyproj import CRS

from SCons.Script import Action, Builder

# ============================================================================
# CONFIGURATION
# ============================================================================

atlas_master = 'atlas_master.xlsx'

# All plate rows in atlas_master.xlsx belong to Volume I. Volume II is the
# text volume and contributes OCR PDFs only, not georeferenced plates.
ATLAS_VOLUME = 1

# CRS of the incoming (already roughly georeferenced) raw rasters. Used only
# to convert tie point geometries into source pixel coordinates.
SOURCE_CRS = 3031

# CRS used for output when the spreadsheet leaves "Target crs" empty.
DEFAULT_CRS = 3031

# Export directory
export_dir = 'export'

# Directory paths
jpg_large_dir = f'{export_dir}/jpg_large/atlas_antarktiki_I'
jpg_small_dir = f'{export_dir}/jpg_small/atlas_antarktiki_I'
pdf_page_I_dir = f'{export_dir}/pdf_color/atlas_antarktiki_I'
pdf_page_II_dir = f'{export_dir}/pdf_color/atlas_antarktiki_II'

for d in [jpg_large_dir, jpg_small_dir, pdf_page_I_dir, pdf_page_II_dir]:
    os.makedirs(d, exist_ok=True)


# ============================================================================
# PDF OUTPUT SETTINGS
# ============================================================================
# The compiled volume PDFs are colour. Two stages decide quality and size:
#
#   1. ImageMagick renders one PDF per scan. '-density' only declares how many
#      scan pixels make up an inch, i.e. the physical sheet size in the PDF —
#      it does not resample, so leave it matching the scans. Size at this
#      stage is set by the JPEG quality and the chroma subsampling.
#   2. Ghostscript merges the pages and downsamples every image to
#      PDF_MERGE_DPI, recompressing at PDF_MERGE_JPEG_QUALITY. This is where
#      the real size reduction happens, so per-page quality can stay generous.
#
# Measured on test plates (3 sheets, 52 MB of LZW TIFF in):
#   old grey pipeline, '/ebook' only    0.58 MB/page
#   colour, PDF_MERGE_DPI = 150         0.46 MB/page   (smaller AND in colour)
#   colour, PDF_MERGE_DPI = 200         0.76 MB/page
# 150 dpi reads comfortably on screen; raise it to 200 or 300 if the compiled
# volume is meant for printing. Fine detail lives in the GeoTIFFs and the
# large JPEGs anyway.
# ============================================================================

PDF_COLOUR = True            # False restores the previous grey/bitonal output

PDF_PAGE_DENSITY_I = 400     # Volume I plates: sheet size declaration, dpi
PDF_PAGE_DENSITY_II = 300    # Volume II text pages

PDF_PAGE_QUALITY_I = 72      # per-page JPEG quality before the merge
PDF_PAGE_QUALITY_II = 65

PDF_CHROMA_SUBSAMPLING = '4:2:0'   # halves the colour channels: large saving,
                                   # invisible on scanned paper. '4:4:4' keeps
                                   # full chroma if a plate shows artefacts.
PDF_PAGE_LEVEL = '1%,99%'    # gentle contrast stretch


PDF_MERGE_DPI = 150          # Ghostscript downsample target for the volumes
PDF_MERGE_JPEG_QUALITY = 70  # Ghostscript recompression quality (0-100)


# ============================================================================
# SINGLE ENVIRONMENT DEFINITION
# ============================================================================

env = Environment(ENV=os.environ.copy())


# ============================================================================
# IMAGE CONVERSION AND PDF GENERATION
# ============================================================================

# ----------------------------------------------------------------------------
# IMPORTANT: these run through Python function actions, not command strings.
#
# The scan directories contain a space ("LZW compression TIFF/Atlas Antarktiki
# II"). SCons splits a command *string* on whitespace when it builds the argv
# list, and quoting does not prevent that — the split happens after
# substitution, so 'magick "$SOURCE"' turns into the arguments "LZW,
# compression, TIFF/Atlas, ... and ImageMagick reports
#     no decode delegate for this image format `LZW'
# Passing an explicit argv list to subprocess removes the shell and the
# splitting entirely, so paths with spaces (or quotes, or brackets) are safe.
# ----------------------------------------------------------------------------

MAGICK = 'magick'
GHOSTSCRIPT = 'gs'

MAGICK_LARGE_JPG_ARGS = [
    '-define', 'registry:warning=none', '-compress', 'JPEG',
    '-quality', '90%', '-level', '1%,99%',
]
MAGICK_SMALL_JPG_ARGS = [
    '-define', 'registry:warning=none', '-resize', '50%', '-compress', 'JPEG',
    '-quality', '55%', '-level', '2%,98%',
]


def magick_pdf_args(density, quality):
    """
    ImageMagick arguments for one page PDF.

    Colour path (PDF_COLOUR): stay in sRGB, stretch contrast gently, flatten
    onto white, straighten, then JPEG with chroma subsampling. Deliberately
    no '-normalize' (it rebalances every sheet independently), no
    '-morphology Close' and no '-sharpen' — those were bitonal cleanup steps
    that on a colour scan mostly add JPEG noise, and noise is bytes.

    Grey path: the previous bitonal recipe, kept for comparison.
    """
    common = ['-define', 'registry:warning=none', '-density', str(density)]

    if PDF_COLOUR:
        return common + [
            '-colorspace', 'sRGB',
            '-level', PDF_PAGE_LEVEL,
            '-background', 'white', '-flatten',
            '-deskew', '40%', '+repage',
            '-sampling-factor', PDF_CHROMA_SUBSAMPLING,
            '-strip',
            '-quality', str(quality), '-compress', 'jpeg',
        ]

    return common + [
        '-colorspace', 'gray',
        '-normalize', '-level', '4%,96%',
        '-background', 'white', '-flatten',
        '-morphology', 'Close', 'Diamond:1', '-sharpen', '0x1.0',
        '-deskew', '40%', '+repage',
        '-quality', str(quality), '-compress', 'jpeg',
    ]


MAGICK_PDF_I_ARGS = magick_pdf_args(PDF_PAGE_DENSITY_I, PDF_PAGE_QUALITY_I)
MAGICK_PDF_II_ARGS = magick_pdf_args(PDF_PAGE_DENSITY_II, PDF_PAGE_QUALITY_II)


def run_argv(argv, description):
    """Run a command from an argv list. Returns 0 on success, 1 on failure."""
    try:
        result = subprocess.run(argv, check=False)
    except FileNotFoundError:
        print(f"ERROR: {argv[0]} not found on PATH — cannot {description}")
        return 1
    if result.returncode != 0:
        print(f"ERROR: {argv[0]} exited {result.returncode} while trying to {description}")
        return 1
    return 0


def magick_builder(target, source, env):
    """Run ImageMagick with MAGICK_ARGS, source and target passed as argv."""
    src_path = str(source[0])
    tgt_path = str(target[0])
    argv = [MAGICK, src_path] + list(env['MAGICK_ARGS']) + [tgt_path]
    return run_argv(argv, f"convert {os.path.basename(src_path)}")


magick_action = Action(magick_builder, "Converting $SOURCE -> $TARGET",
                       varlist=['MAGICK_ARGS'])
env.Append(BUILDERS={'Magick': Builder(action=magick_action)})


def ghostscript_argv(tgt_path):
    """
    Ghostscript arguments for merging the page PDFs into one volume.

    '/ebook' is only a baseline here; the explicit image settings that follow
    override it, because the preset's fixed 150 dpi and automatic filter choice
    gave no control over the colour/size trade-off. Downsampling to
    PDF_MERGE_DPI and recompressing at PDF_MERGE_JPEG_QUALITY is what keeps a
    colour volume to a sane size.
    """
    argv = [
        GHOSTSCRIPT, '-sDEVICE=pdfwrite', '-dNOPAUSE', '-dBATCH', '-dSAFER',
        f'-sOutputFile={tgt_path}',
        '-dAutoRotatePages=/None',
        '-dCompatibilityLevel=1.7',
        '-dPDFSETTINGS=/ebook',
        '-dDetectDuplicateImages=true',
        '-dCompressFonts=true', '-dSubsetFonts=true',
    ]

    if PDF_COLOUR:
        argv += [
            # Keep everything in sRGB: no CMYK, no separation to grey.
            '-dColorConversionStrategy=/sRGB',
            '-dProcessColorModel=/DeviceRGB',
            '-dConvertCMYKImagesToRGB=true',
        ]
    else:
        argv += ['-dColorConversionStrategy=/Gray',
                 '-dProcessColorModel=/DeviceGray']

    argv += [
        # Downsample and recompress every image explicitly.
        '-dDownsampleColorImages=true',
        '-dColorImageDownsampleType=/Bicubic',
        f'-dColorImageResolution={PDF_MERGE_DPI}',
        '-dAutoFilterColorImages=false',
        '-dColorImageFilter=/DCTEncode',
        '-dDownsampleGrayImages=true',
        '-dGrayImageDownsampleType=/Bicubic',
        f'-dGrayImageResolution={PDF_MERGE_DPI}',
        '-dAutoFilterGrayImages=false',
        '-dGrayImageFilter=/DCTEncode',
        '-dDownsampleMonoImages=true',
        '-dMonoImageDownsampleType=/Subsample',
        f'-dMonoImageResolution={PDF_MERGE_DPI * 2}',
        f'-dJPEGQ={PDF_MERGE_JPEG_QUALITY}',
    ]
    return argv


def ghostscript_builder(target, source, env):
    """Merge PDFs with Ghostscript, page order given by the source order."""
    tgt_path = str(target[0])
    argv = ghostscript_argv(tgt_path) + [str(s) for s in source]
    return run_argv(argv, f"compile {os.path.basename(tgt_path)} "
                          f"from {len(source)} page(s)")


# The colour/size settings are part of the target signature, so changing any
# of them recompiles the volumes without a manual clean.
ghostscript_action = Action(
    ghostscript_builder, "Compiling PDF $TARGET",
    varlist=['PDF_MERGE_DPI', 'PDF_MERGE_JPEG_QUALITY', 'PDF_COLOUR'])
env.Append(BUILDERS={'MergePDF': Builder(action=ghostscript_action)})

# One environment per argument set, reused for every scan, so the arguments
# are part of each target's signature (via varlist) without cloning per file.
env_large_jpg = env.Clone(MAGICK_ARGS=MAGICK_LARGE_JPG_ARGS)
env_small_jpg = env.Clone(MAGICK_ARGS=MAGICK_SMALL_JPG_ARGS)
env_pdf_I = env.Clone(MAGICK_ARGS=MAGICK_PDF_I_ARGS)
env_pdf_II = env.Clone(MAGICK_ARGS=MAGICK_PDF_II_ARGS)

# Expose the merge settings to the PDF builder's varlist.
env['PDF_MERGE_DPI'] = PDF_MERGE_DPI
env['PDF_MERGE_JPEG_QUALITY'] = PDF_MERGE_JPEG_QUALITY
env['PDF_COLOUR'] = PDF_COLOUR

image_nodes = []

# Build images and PDFs for Volume I
pdf_I_nodes = {}
for tiff in Glob('LZW compression TIFF/Atlas Antarktiki I/*.tif'):
    base_name = os.path.splitext(os.path.basename(str(tiff)))[0]

    large = env_large_jpg.Magick(target=f'{jpg_large_dir}/{base_name}.jpg', source=tiff)
    small = env_small_jpg.Magick(target=f'{jpg_small_dir}/{base_name}.jpg', source=tiff)
    node = env_pdf_I.Magick(target=f'{pdf_page_I_dir}/{base_name}.pdf', source=tiff)

    image_nodes.extend(list(large) + list(small) + list(node))
    pdf_I_nodes[base_name] = node[0]

# Build OCR PDFs for Volume II
pdf_II_nodes = {}
for tiff in Glob('LZW compression TIFF/Atlas Antarktiki II/*.tif'):
    base_name = os.path.splitext(os.path.basename(str(tiff)))[0]
    node = env_pdf_II.Magick(target=f'{pdf_page_II_dir}/{base_name}.pdf', source=tiff)
    image_nodes.extend(list(node))
    pdf_II_nodes[base_name] = node[0]


# ============================================================================
# PDF COMPILATION ORDERING
# ============================================================================

def get_ordered_nodes(csv_filename, node_dict):
    """
    Read CSV to determine page ordering for compiled PDF.

    Returns [] when the CSV is missing or unusable, so a compiled PDF can be
    skipped without aborting the rest of the build.
    """
    if not os.path.isfile(csv_filename):
        print(f"WARNING: Page-order file not found: {csv_filename} "
              f"— skipping the compiled PDF for this volume.")
        return []

    rows = []
    try:
        with open(csv_filename, newline='', encoding='utf-8') as csvfile:
            reader = csv.DictReader(csvfile)
            fieldnames = reader.fieldnames or []
            missing = [c for c in ('Raw path', 'Compile order') if c not in fieldnames]
            if missing:
                print(f"WARNING: {csv_filename} is missing column(s) {missing} "
                      f"(found {fieldnames}) — skipping the compiled PDF.")
                return []

            unmatched = 0
            for row in reader:
                raw_path = (row.get('Raw path') or '').strip()
                compile_order = (row.get('Compile order') or '').strip()
                if not raw_path or not compile_order.isdigit():
                    continue
                base = os.path.splitext(os.path.basename(raw_path))[0]
                if base in node_dict:
                    rows.append((int(compile_order), base, node_dict[base]))
                else:
                    unmatched += 1

            if unmatched:
                print(f"WARNING: {csv_filename}: {unmatched} row(s) reference pages "
                      f"with no matching scan — they are omitted from the compiled PDF.")
    except Exception as e:
        print(f"WARNING: Could not read {csv_filename}: {e} — skipping the compiled PDF.")
        return []

    rows.sort(key=lambda item: (item[0], item[1]))
    return [node for _, _, node in rows]


compiled_pdfs = []

for volume_label, csv_file, node_dict in (
    ('I', 'volume_I.csv', pdf_I_nodes),
    ('II', 'volume_II.csv', pdf_II_nodes),
):
    ordered_nodes = get_ordered_nodes(csv_file, node_dict)
    if not ordered_nodes:
        continue
    vol_pdf = env.MergePDF(
        target=f'{export_dir}/atlas_antarktiki_{volume_label}_complete.pdf',
        source=ordered_nodes,
    )
    env.Depends(vol_pdf, csv_file)
    compiled_pdfs.append(vol_pdf)
    print(f"Configured compiled PDF for Volume {volume_label} "
          f"({len(ordered_nodes)} pages from {csv_file})")


# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

def get_target_crs(crs_value, default_crs=DEFAULT_CRS):
    """
    Extract and validate EPSG code from Excel cell.
    Returns integer EPSG code or default.
    """
    if crs_value is None or pd.isna(crs_value):
        return default_crs

    crs_str = str(crs_value).strip()

    if crs_str in ('', '-', 'NA', 'N/A', 'None', 'nan', '<NA>'):
        return default_crs

    try:
        return int(float(crs_str))
    except (TypeError, ValueError):
        print(f"WARNING: Unrecognised 'Target crs' value {crs_value!r} "
              f"— falling back to EPSG:{default_crs}")
        return default_crs


# Characters that NFKD cannot decompose into ASCII on their own.
_ASCII_FOLD_MAP = {
    'ø': 'o', 'Ø': 'O', 'æ': 'ae', 'Æ': 'AE', 'å': 'a', 'Å': 'A',
    'ð': 'd', 'Ð': 'D', 'þ': 'th', 'Þ': 'Th', 'ß': 'ss', 'ł': 'l', 'Ł': 'L',
    'đ': 'd', 'Đ': 'D', 'ı': 'i', 'œ': 'oe', 'Œ': 'OE',
    'δ': 'delta', 'Δ': 'delta', 'α': 'alpha', 'β': 'beta', 'γ': 'gamma',
    'μ': 'mu', 'σ': 'sigma', 'ρ': 'rho', 'λ': 'lambda', 'ω': 'omega',
    '°': 'deg', '–': '-', '—': '-', '’': '', '‘': '', '“': '', '”': '',
}


def ascii_fold(text):
    """
    Reduce a string to plain ASCII. Classic BibTeX (as opposed to biber)
    cannot handle non-ASCII citation keys, and titles such as
    'Lützow-Holm', 'Sørsdal' and 'Magnetic anomalies δTa' would otherwise
    leak non-ASCII characters into the keys.
    """
    text = ''.join(_ASCII_FOLD_MAP.get(ch, ch) for ch in str(text))
    text = unicodedata.normalize('NFKD', text)
    text = ''.join(ch for ch in text if not unicodedata.combining(ch))
    return text.encode('ascii', 'ignore').decode('ascii')


def sanitise_key(text):
    """
    Convert a string into a safe BibTeX citation key fragment.
    ASCII-folds first, then keeps alphanumerics and underscores and
    collapses whitespace to '_'.
    """
    text = ascii_fold(text)
    text = re.sub(r'[^A-Za-z0-9\s_]', '', text)
    text = re.sub(r'[\s_]+', '_', text.strip())
    return text.strip('_').lower()


def safe_field(value):
    """Return field value as a cleaned string, or empty string if NaN/missing."""
    if value is None:
        return ''
    try:
        if pd.isna(value):
            return ''
    except (TypeError, ValueError):
        pass
    text = str(value).strip()
    if text in ('nan', '<NA>', 'None'):
        return ''
    return text


def escape_bibtex(text):
    """Escape TeX special characters in a field value."""
    text = str(text)
    text = text.replace('\\', r'\textbackslash{}')
    for ch in ('&', '%', '#', '_', '$', '{', '}'):
        text = text.replace(ch, '\\' + ch)
    text = text.replace('~', r'\textasciitilde{}')
    text = text.replace('^', r'\textasciicircum{}')
    return text


# ============================================================================
# BIBTEX GENERATION FOR INDIVIDUAL MAP PLATES
# ============================================================================

# A cartographic ratio, optionally with a unit suffix such as
# '1:30 miles/inch'. Content-type words ('photo', 'diagram', 'table') do
# not match.
_SCALE_RE = re.compile(r'^\s*1\s*:\s*[\d,\.\s]+([A-Za-z][A-Za-z\s/\.]*)?$')


def is_map_scale(scale_str):
    """
    Return True if scale_str looks like a cartographic ratio
    (e.g. '1:80,000,000' or '1:30 miles/inch').
    Returns False for content-type words like 'photo', 'diagram', 'table'.
    """
    return bool(_SCALE_RE.match(str(scale_str)))


def generate_bibtex_entry(row, volume=ATLAS_VOLUME):
    """
    Generate a BibTeX @incollection entry for any row in the atlas spreadsheet.

    Scale field interpretation:
        - Ratio string (e.g. '1:80,000,000') → type = {map}, note = {Scale ...}
        - Word  (e.g. 'photo', 'diagram')    → type = {photo} / {diagram} etc.
        - Empty / NaN                         → type field omitted

    Fields populated from spreadsheet columns:
        Part, Section, Subsection, Plate, Map Index, Map Subindex,
        Title, Sub title, Scale, Author, Editor
    """

    plate = safe_field(row.get('Plate', ''))
    map_idx = safe_field(row.get('Map Index', ''))
    map_subidx = safe_field(row.get('Map Subindex', ''))
    title = safe_field(row.get('Title', ''))

    plate_str = sanitise_key(plate).zfill(3) if plate else '000'
    idx_str = f"_{sanitise_key(map_idx)}" if map_idx else ''
    # Map Subindex values such as '(Ye)' would put parentheses in the key.
    subidx_str = sanitise_key(map_subidx) if map_subidx else ''
    title_fragment = sanitise_key(title)[:30] if title else 'untitled'

    volume_label = 'I' if int(volume) == 1 else 'II'
    cite_key = f"atlas_{volume_label}_{plate_str}{idx_str}{subidx_str}_{title_fragment}"
    cite_key = re.sub(r'_+', '_', cite_key).strip('_')

    # Title: combine Title and Sub title
    entry_title = escape_bibtex(title) if title else 'Untitled'
    subtitle = safe_field(row.get('Sub title', ''))
    if subtitle:
        entry_title += f": {escape_bibtex(subtitle)}"

    author = safe_field(row.get('Author', ''))
    editor = safe_field(row.get('Editor', ''))
    scale = safe_field(row.get('Scale', ''))

    # Determine content type from Scale field
    if scale and is_map_scale(scale):
        content_type = 'map'
        scale_note = f"Scale {escape_bibtex(scale)}"
    elif scale:
        content_type = escape_bibtex(scale.lower().strip())
        scale_note = ''
    else:
        content_type = ''
        scale_note = ''

    part = safe_field(row.get('Part', ''))
    section = safe_field(row.get('Section', ''))
    subsection = safe_field(row.get('Subsection', ''))

    location_parts = []
    if part:
        location_parts.append(f"Part {escape_bibtex(part)}")
    if section:
        location_parts.append(f"Section {escape_bibtex(section)}")
    if subsection:
        location_parts.append(f"Subsection {escape_bibtex(subsection)}")

    plate_ref = ''
    if plate:
        plate_ref = f"Plate {escape_bibtex(plate)}"
        if map_idx:
            plate_ref += f", Map {escape_bibtex(map_idx)}"
        if map_subidx:
            plate_ref += f"{escape_bibtex(map_subidx)}"

    lines = []
    lines.append(f"@incollection{{{cite_key},")

    if author:
        lines.append(f"  author       = {{{escape_bibtex(author)}}},")

    lines.append(f"  title        = {{{entry_title}}},")
    lines.append(f"  booktitle    = {{Atlas Antarktiki}},")

    if editor:
        lines.append(f"  editor       = {{{escape_bibtex(editor)}}},")

    lines.append(f"  volume       = {{{int(volume)}}},")
    lines.append(f"  publisher    = {{Glavnoye upravleniye geodezii i kartografii pri Sovete Ministrov SSSR}},")
    lines.append(f"  address      = {{Moscow}},")
    lines.append(f"  year         = {{1966}},")

    if content_type:
        lines.append(f"  type         = {{{content_type}}},")

    if scale_note:
        lines.append(f"  note         = {{{scale_note}}},")
    elif location_parts:
        lines.append(f"  note         = {{{'; '.join(location_parts)}}},")

    if scale_note and location_parts:
        lines.append(f"  annote       = {{{'; '.join(location_parts)}}},")

    if plate_ref:
        lines.append(f"  pages        = {{{plate_ref}}},")

    lines.append(f"  crossref     = {{tolstikov1966}}")
    lines.append(f"}}")

    return cite_key, '\n'.join(lines)


# Keep old name as alias for backward compatibility within this file
generate_map_bibtex = generate_bibtex_entry


ATLAS_PARENT_BIB = """@book{tolstikov1966,
  author    = {Tolstikov, Evgenii Ivanovich},
  title     = {Atlas Antarktiki},
  volume    = {1},
  year      = {1966},
  publisher = {Glavnoye upravleniye geodezii i kartografii pri Sovete Ministrov SSSR},
  address   = {Moscow}
}
"""


def write_bibtex_file(bib_path, bib_entry):
    """
    Write a .bib file containing the atlas parent entry and the map entry.
    """
    content = (
        f"% Auto-generated by SConstruct — {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n"
        f"% Map-level citation for: {Path(bib_path).stem}\n\n"
        f"{ATLAS_PARENT_BIB}\n"
        f"{bib_entry}\n"
    )
    with open(bib_path, 'w', encoding='utf-8') as f:
        f.write(content)


def bibtex_builder(target, source, env):
    """
    SCons builder that generates a .bib file for a map plate.

    target[0]: .bib file (output)
    source[0]: a Value node holding the rendered entry
    env: must contain BIB_ENTRY (the pre-rendered BibTeX string)
    """
    bib_path = str(target[0])
    bib_entry = env.get('BIB_ENTRY', '')

    try:
        write_bibtex_file(bib_path, bib_entry)
        print(f"OK: Generated {bib_path}")
        return 0
    except Exception as e:
        print(f"ERROR: Writing {bib_path}: {e}")
        return 1


bibtex_action = Action(bibtex_builder, "Generating BibTeX $TARGET", varlist=['BIB_ENTRY'])
bibtex_builder_obj = Builder(action=bibtex_action)
env.Append(BUILDERS={'BibTeX': bibtex_builder_obj})


# ============================================================================
# GEOREFERENCING FUNCTION
# ============================================================================

# Layer names to prefer inside a multi-layer GPKG, and layers that are never
# tie points (QGIS writes 'layer_styles' alongside the data).
TIE_POINT_LAYERS = ('tie_points', 'tiepoints', 'tie_point', 'points', 'gcps')
NON_DATA_LAYERS = ('layer_styles', 'qgis_projects', 'gpkg_metadata')


def list_gpkg_layers(path):
    """Return the layer names in a vector file, or [] if they can't be listed."""
    try:
        import pyogrio
        return [str(row[0]) for row in pyogrio.list_layers(path)]
    except Exception:
        pass
    try:
        return [str(n) for n in gpd.list_layers(path)['name']]
    except Exception:
        return []


def pick_tie_point_layer(path):
    """
    Choose which layer holds the tie points.

    QGIS-authored GPKGs usually contain a 'layer_styles' table next to the
    data, which makes an unqualified read emit a 'More than one layer found'
    warning and rely on layer order. Returns (layer_name_or_None, notes).
    """
    layers = list_gpkg_layers(path)
    if len(layers) <= 1:
        return None, []

    for preferred in TIE_POINT_LAYERS:
        for layer in layers:
            if layer.lower() == preferred:
                return layer, []

    candidates = [l for l in layers if l.lower() not in NON_DATA_LAYERS]
    if len(candidates) == 1:
        return candidates[0], [f"NOTE: Using layer '{candidates[0]}' of {layers}"]
    if candidates:
        return candidates[0], [
            f"WARNING: {Path(path).name} has several candidate layers {candidates}; "
            f"using '{candidates[0]}'. Rename the tie point layer to 'tie_points' "
            f"to make this unambiguous."
        ]
    return None, [f"WARNING: No obvious tie point layer among {layers}"]


def load_tie_points(tie_points):
    """
    Read a tie point layer and return it in EPSG:4326.

    Requires point geometry (the map's current position) plus 'lon'/'lat'
    columns (the intended position). Raises ValueError on anything missing,
    so a malformed layer fails loudly instead of producing a bad transform.
    """
    layer, layer_notes = pick_tie_point_layer(tie_points)
    if layer is not None:
        gdf = gpd.read_file(tie_points, layer=layer)
    else:
        gdf = gpd.read_file(tie_points)

    if gdf.empty:
        raise ValueError(f"{tie_points} contains no tie points")

    missing = [c for c in ('lon', 'lat') if c not in gdf.columns]
    if missing:
        raise ValueError(
            f"{tie_points} is missing required column(s) {missing} "
            f"(found {list(gdf.columns)})"
        )

    notes = list(layer_notes)
    wgs84 = CRS.from_epsg(4326)
    if gdf.crs is None:
        notes.append(f"WARNING: {tie_points} has no CRS — assuming EPSG:4326")
        gdf = gdf.set_crs(wgs84)
    elif not CRS.from_user_input(gdf.crs).equals(wgs84):
        notes.append(f"NOTE: Reprojected tie points from {gdf.crs.to_string()} to EPSG:4326")
        gdf = gdf.to_crs(wgs84)

    if not (gdf.geometry.geom_type == 'Point').all():
        raise ValueError(f"{tie_points} contains non-point geometry")

    if gdf[['lon', 'lat']].isna().any().any():
        raise ValueError(f"{tie_points} has empty lon/lat values")

    return gdf, notes


def parse_scale_denominator(scale_str):
    """
    Return the denominator of a cartographic ratio, or None.
    '1:40,000,000' -> 40000000; 'Photo' / '1:30 miles/inch' -> None.
    """
    text = str(scale_str or '').strip()
    m = re.match(r'^\s*1\s*:\s*([\d,\.\s]+)\s*$', text)
    if not m:
        return None
    digits = re.sub(r'[,\s]', '', m.group(1)).rstrip('.')
    try:
        value = float(digits)
    except ValueError:
        return None
    return value if value > 0 else None


def fit_similarity(gcp_rows, flip=True):
    """
    Fit a 4-parameter conformal transform (uniform scale + rotation +
    translation) from 2 or more points. Exact for 2 points, least squares
    beyond that.

    flip=True uses the mirrored form appropriate for row-down image
    coordinates (north-up rasters, where the affine 'e' term is negative):
        x = a*col + b*row + c
        y = b*col - a*row + f
    """
    A = []
    b_vec = []
    sign = -1.0 if flip else 1.0
    for res in gcp_rows:
        col, row_ = res['pix_col'], res['pix_row']
        A.append([col, row_, 1.0, 0.0])
        b_vec.append(res['tgt_x'])
        A.append([sign * row_, col, 0.0, 1.0])
        b_vec.append(res['tgt_y'])

    A = np.asarray(A, dtype=float)
    b_vec = np.asarray(b_vec, dtype=float)

    params, _res, rank, _sv = np.linalg.lstsq(A, b_vec, rcond=None)

    # Rank-deficient means the points do not constrain all 4 parameters —
    # typically two tie points digitised at the same pixel. lstsq would
    # happily return a minimum-norm answer, so reject it explicitly.
    if rank < 4:
        raise ValueError(
            f"Similarity fit is degenerate (rank {rank} of 4) — "
            f"tie points are coincident or too close together"
        )

    a, b, c, f = (float(p) for p in params)

    if not np.isfinite([a, b, c, f]).all() or (a == 0.0 and b == 0.0):
        raise ValueError("Similarity fit is degenerate (no scale recovered)")

    return Affine(a, b, c, b, sign * a, f)


def fit_translation(gcp_rows, src_transform):
    """
    Fit translation only, keeping the source raster's scale and rotation.
    Usable with a single tie point.
    """
    a, b, d, e = (src_transform.a, src_transform.b,
                  src_transform.d, src_transform.e)
    if not any((a, b, d, e)):
        raise ValueError("Source raster has no usable scale/rotation to preserve")

    dx = np.mean([res['tgt_x'] - (a * res['pix_col'] + b * res['pix_row'])
                  for res in gcp_rows])
    dy = np.mean([res['tgt_y'] - (d * res['pix_col'] + e * res['pix_row'])
                  for res in gcp_rows])
    return Affine(a, b, float(dx), d, e, float(dy))


def fit_transform(gcp_rows, gcps, src_transform):
    """
    Choose and fit the best transform the tie points can support.

    >=3 points : affine (6 parameters, least squares via from_gcps)
     2 points  : conformal similarity (4 parameters)
     1 point   : translation only (2 parameters)

    Returns (transform, description, n_parameters).
    """
    n = len(gcp_rows)

    if n >= 3:
        try:
            return (from_gcps(gcps),
                    'Affine (1st-order polynomial, 6 parameters)', 6)
        except Exception as e:
            # Collinear or otherwise degenerate point configuration.
            print(f"WARNING: Affine fit failed ({e}); falling back to similarity")
            return (fit_similarity(gcp_rows, flip=(src_transform.e < 0)),
                    'Similarity (conformal, 4 parameters) — affine fit degenerate', 4)

    if n == 2:
        return (fit_similarity(gcp_rows, flip=(src_transform.e < 0)),
                'Similarity (conformal: scale + rotation + translation, '
                '4 parameters) — only 2 tie points available', 4)

    return (fit_translation(gcp_rows, src_transform),
            'Translation only (2 parameters, source scale and rotation kept) '
            '— only 1 tie point available', 2)


def assess_quality(rmse_m, scale_denominator):
    """
    Grade the fit. When the map scale is known, judge the residual as a
    distance on the printed sheet: 0.5 mm is the conventional plotting
    accuracy, so a fixed metre threshold is meaningless across plates
    ranging from 1:2,000 to 1:180,000,000.
    """
    if scale_denominator:
        rmse_mm = rmse_m / scale_denominator * 1000.0
        if rmse_mm < 0.25:
            grade = 'EXCELLENT'
        elif rmse_mm < 0.5:
            grade = 'GOOD'
        elif rmse_mm < 1.0:
            grade = 'ACCEPTABLE'
        else:
            grade = 'POOR'
        detail = (f"{grade} (RMSE {rmse_m:.0f} m = {rmse_mm:.2f} mm "
                  f"at 1:{scale_denominator:,.0f})")
        return grade, rmse_mm, detail

    if rmse_m < 100:
        grade = 'EXCELLENT'
    elif rmse_m < 500:
        grade = 'GOOD'
    elif rmse_m < 1000:
        grade = 'ACCEPTABLE'
    else:
        grade = 'POOR'
    return grade, None, f"{grade} (RMSE: {rmse_m:.2f} m; map scale unknown)"


def georeference_map(source_raster, target_raster, tie_points, log_file,
                     target_crs=DEFAULT_CRS, source_crs=SOURCE_CRS,
                     map_scale=None):
    """
    Re-georeferences from point vector using affine (1st-order polynomial) fit.

    source_crs describes the CRS the raw raster's existing transform is in and
    is used only to turn tie point geometries into pixel coordinates.
    target_crs is the CRS written to the output raster.

    Generates a detailed log file with transformation statistics.
    Returns the path to the log file.
    """

    log_lines = []
    log_lines.append("=" * 80)
    log_lines.append("GEOREFERENCING REPORT")
    log_lines.append("=" * 80)
    log_lines.append(f"Date: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    log_lines.append(f"Source Raster: {source_raster}")
    log_lines.append(f"Target Raster: {target_raster}")
    log_lines.append(f"Tie Points: {tie_points}")
    log_lines.append("")

    source_crs_obj = CRS.from_epsg(int(source_crs))
    custom_crs = CRS.from_epsg(int(target_crs))
    log_lines.append(f"Source CRS (pixel lookup): EPSG:{int(source_crs)} — {source_crs_obj.name}")
    log_lines.append(f"Target CRS (output):       EPSG:{int(target_crs)} — {custom_crs.name}")
    print(f"Using source CRS EPSG:{int(source_crs)} → target CRS EPSG:{int(target_crs)}")

    gdf, tp_notes = load_tie_points(tie_points)
    for note in tp_notes:
        log_lines.append(note)
        print(note)
    log_lines.append(f"Number of tie points: {len(gdf)}")
    print(f"Loaded {len(gdf)} tie points from {tie_points}")

    with rasterio.open(source_raster) as src:
        log_lines.append(f"Source dimensions: {src.width} x {src.height} pixels")
        log_lines.append(f"Source bands: {src.count}")
        log_lines.append(f"Source declared CRS: {src.crs.to_string() if src.crs else 'none'}")
        print(f"Source raster: {src.width} x {src.height} pixels")

        # The raw rasters are expected to carry a 3031 transform. If the file
        # says otherwise, the pixel lookup below is likely wrong — say so
        # loudly rather than silently emitting a bad transform.
        if src.crs is None:
            msg = (f"WARNING: {Path(source_raster).name} declares no CRS; "
                   f"assuming its transform is EPSG:{int(source_crs)}")
            log_lines.append(msg)
            print(msg)
        elif not CRS.from_user_input(src.crs).equals(source_crs_obj):
            msg = (f"WARNING: {Path(source_raster).name} declares "
                   f"{src.crs.to_string()} but pixel lookup assumes "
                   f"EPSG:{int(source_crs)}. Check SOURCE_CRS — the fitted "
                   f"transform may be invalid.")
            log_lines.append(msg)
            print(msg)

        # Tie point geometry → source pixel coordinates (in source CRS)
        to_source = pyproj.Transformer.from_crs("EPSG:4326", source_crs_obj, always_xy=True)
        # Tie point lon/lat → intended map coordinates (in target CRS)
        to_target = pyproj.Transformer.from_crs("EPSG:4326", custom_crs, always_xy=True)

        gcps = []
        residuals = []

        log_lines.append("")
        log_lines.append("-" * 80)
        log_lines.append("CONTROL POINTS")
        log_lines.append("-" * 80)
        log_lines.append(
            f"{'ID':<5} {'Pixel X':<10} {'Pixel Y':<10} "
            f"{'Src X':<12} {'Src Y':<12} {'Target X':<12} {'Target Y':<12}"
        )
        log_lines.append("-" * 80)

        for point_no, (idx, row) in enumerate(gdf.iterrows(), start=1):
            curr_lon, curr_lat = row.geometry.x, row.geometry.y
            curr_x, curr_y = to_source.transform(curr_lon, curr_lat)

            pix_col, pix_row = ~src.transform * (curr_x, curr_y)

            tgt_lon, tgt_lat = float(row["lon"]), float(row["lat"])
            tgt_x, tgt_y = to_target.transform(tgt_lon, tgt_lat)

            gcps.append(
                GroundControlPoint(row=pix_row, col=pix_col, x=tgt_x, y=tgt_y, z=0)
            )

            residuals.append({
                'id': point_no,
                'pix_col': pix_col,
                'pix_row': pix_row,
                'curr_x': curr_x,
                'curr_y': curr_y,
                'tgt_x': tgt_x,
                'tgt_y': tgt_y
            })

            log_lines.append(
                f"{point_no:<5} {pix_col:<10.1f} {pix_row:<10.1f} "
                f"{curr_x:<12.0f} {curr_y:<12.0f} {tgt_x:<12.0f} {tgt_y:<12.0f}"
            )

        # Fit the richest transform the point count supports rather than
        # failing outright: affine needs 3 points, similarity 2, translation 1.
        new_transform, transform_desc, n_params = fit_transform(
            residuals, gcps, src.transform)
        if n_params < 6:
            msg = (f"WARNING: {Path(source_raster).name}: {len(gcps)} tie point(s) "
                   f"— using {transform_desc.split(' —')[0]} instead of a full affine")
            log_lines.append(msg)
            print(msg)

        log_lines.append("")
        log_lines.append("-" * 80)
        log_lines.append("RESIDUAL ANALYSIS")
        log_lines.append("-" * 80)
        log_lines.append(f"{'ID':<5} {'dX (m)':<12} {'dY (m)':<12} {'Residual (m)':<15}")
        log_lines.append("-" * 80)

        residual_errors = []
        dx_list = []
        dy_list = []

        for res in residuals:
            predicted_x, predicted_y = new_transform * (res['pix_col'], res['pix_row'])

            dx = predicted_x - res['tgt_x']
            dy = predicted_y - res['tgt_y']
            residual = np.sqrt(dx**2 + dy**2)

            residual_errors.append(residual)
            dx_list.append(dx)
            dy_list.append(dy)

            log_lines.append(f"{res['id']:<5} {dx:<12.2f} {dy:<12.2f} {residual:<15.2f}")

        residual_errors = np.array(residual_errors)
        dx_array = np.array(dx_list)
        dy_array = np.array(dy_list)

        rmse = np.sqrt(np.mean(residual_errors**2))
        rmse_x = np.sqrt(np.mean(dx_array**2))
        rmse_y = np.sqrt(np.mean(dy_array**2))
        mean_error = np.mean(residual_errors)
        max_error = np.max(residual_errors)
        min_error = np.min(residual_errors)
        std_error = np.std(residual_errors)

        # 2 observations per point, minus the fitted parameters.
        degrees_of_freedom = max(0, 2 * len(gcps) - n_params)

        # How much of the error is one bad point? Cheap outlier diagnostic.
        worst_idx = int(np.argmax(residual_errors))
        if len(residual_errors) > 1:
            without_worst = np.delete(residual_errors, worst_idx)
            rmse_without_worst = float(np.sqrt(np.mean(without_worst**2)))
        else:
            rmse_without_worst = None

        log_lines.append("-" * 80)
        log_lines.append("")
        log_lines.append("TRANSFORMATION STATISTICS")
        log_lines.append("-" * 80)
        log_lines.append(f"Transformation type: {transform_desc}")
        log_lines.append(f"Number of GCPs used: {len(gcps)}")
        log_lines.append(f"Observations:        {2 * len(gcps)} (2 per GCP)")
        log_lines.append(f"Degrees of freedom:  {degrees_of_freedom}")
        log_lines.append("")
        log_lines.append("Residual Errors:")
        log_lines.append(f"  Mean error:     {mean_error:10.2f} m")
        log_lines.append(f"  RMSE (total):   {rmse:10.2f} m")
        log_lines.append(f"  RMSE X:         {rmse_x:10.2f} m")
        log_lines.append(f"  RMSE Y:         {rmse_y:10.2f} m")
        log_lines.append(f"  Std deviation:  {std_error:10.2f} m")
        log_lines.append(f"  Maximum error:  {max_error:10.2f} m  (point {worst_idx + 1})")
        log_lines.append(f"  Minimum error:  {min_error:10.2f} m")
        if rmse_without_worst is not None:
            log_lines.append(f"  RMSE excl. worst point: {rmse_without_worst:10.2f} m "
                             f"({100.0 * (1 - rmse_without_worst / rmse):.0f}% lower)")

        scale_denominator = parse_scale_denominator(map_scale)
        if scale_denominator:
            log_lines.append("")
            log_lines.append(f"Map scale: 1:{scale_denominator:,.0f}")
            log_lines.append(f"  RMSE on the sheet: {rmse / scale_denominator * 1000.0:8.2f} mm")
            log_lines.append(f"  Max error on sheet:{max_error / scale_denominator * 1000.0:8.2f} mm")
            log_lines.append("  (0.5 mm is the conventional plotting accuracy)")
        elif map_scale:
            log_lines.append("")
            log_lines.append(f"Map scale: {map_scale} (not a parsable ratio)")

        log_lines.append("")
        log_lines.append("Transformation Matrix:")
        log_lines.append(f"  a (scale X):    {new_transform.a:15.6f}")
        log_lines.append(f"  b (rotation):   {new_transform.b:15.6f}")
        log_lines.append(f"  c (translation X): {new_transform.c:15.2f}")
        log_lines.append(f"  d (rotation):   {new_transform.d:15.6f}")
        log_lines.append(f"  e (scale Y):    {new_transform.e:15.6f}")
        log_lines.append(f"  f (translation Y): {new_transform.f:15.2f}")

        pixel_size_x = abs(new_transform.a)
        pixel_size_y = abs(new_transform.e)
        rotation = np.degrees(np.arctan2(new_transform.b, new_transform.a))

        log_lines.append("")
        log_lines.append("Derived Parameters:")
        log_lines.append(f"  Pixel size X:   {pixel_size_x:10.2f} m/pixel")
        log_lines.append(f"  Pixel size Y:   {pixel_size_y:10.2f} m/pixel")
        log_lines.append(f"  Rotation:       {rotation:10.4f} degrees")

        log_lines.append("")
        log_lines.append("QUALITY ASSESSMENT")
        log_lines.append("-" * 80)
        quality, rmse_mm, quality_detail = assess_quality(rmse, scale_denominator)
        log_lines.append(f"Overall quality: {quality_detail}")

        if len(gcps) < 4:
            log_lines.append(f"WARNING: Only {len(gcps)} GCP(s) used, so the fit has "
                             f"{degrees_of_freedom} degree(s) of freedom and the "
                             f"residuals below understate the true error. "
                             f"Add more points.")

        if mean_error > 0 and max_error > 3 * mean_error:
            log_lines.append(f"WARNING: Point {worst_idx + 1} has an unusually high residual "
                             f"({max_error:.0f} m vs {mean_error:.0f} m mean).")
            if rmse_without_worst is not None and rmse_without_worst < 0.6 * rmse:
                log_lines.append(f"         Dropping it would reduce RMSE to "
                                 f"{rmse_without_worst:.0f} m. Check that point's "
                                 f"lon/lat against its plotted position.")
            else:
                log_lines.append("         Consider checking this control point.")

        log_lines.append("")
        log_lines.append("=" * 80)

        os.makedirs(str(Path(log_file).parent), exist_ok=True)
        with open(log_file, 'w', encoding='utf-8') as f:
            f.write('\n'.join(log_lines))

        print(f"\nLog file written to: {log_file}")
        print(f"RMSE: {rmse:.2f} m — {quality_detail}")
        if quality == 'POOR':
            print(f"WARNING: {Path(source_raster).name} fit graded POOR; "
                  f"worst point is {worst_idx + 1} ({max_error:.0f} m)")

        profile = src.profile.copy()
        profile.update(crs=custom_crs, transform=new_transform, BIGTIFF='IF_SAFER')
        profile.pop('gcps', None)

        # Write to a temporary file and rename, so an interrupted or failed
        # run never leaves a truncated raster that looks up to date. Bands are
        # copied one at a time to keep peak memory to a single band.
        tmp_raster = f"{target_raster}.tmp.tif"
        os.makedirs(str(Path(target_raster).parent), exist_ok=True)
        try:
            with rasterio.open(tmp_raster, "w", **profile) as dst:
                for band in range(1, src.count + 1):
                    dst.write(src.read(band), band)
                if src.descriptions and any(src.descriptions):
                    dst.descriptions = src.descriptions
            os.replace(tmp_raster, target_raster)
        finally:
            if os.path.exists(tmp_raster):
                os.remove(tmp_raster)

    print(f"Georeferenced raster saved to {target_raster}")
    return str(log_file)


# ============================================================================
# SCons BUILDER FOR GEOREFERENCING
# ============================================================================

def georef_builder(target, source, env):
    """
    SCons builder that calls georeference_map.

    target[0]: log file (output)
    target[1]: georeferenced raster (output)
    source[0]: GPKG tie points file (input)
    source[1]: ungeoreferenced TIFF in the per-map subdirectory (input)
    """
    tie_points = str(source[0])
    source_raster = str(source[1])
    target_log = str(target[0])
    target_raster = str(target[1])

    crs = env.get('TARGET_CRS', DEFAULT_CRS)
    src_crs = env.get('SOURCE_CRS', SOURCE_CRS)
    map_scale = env.get('MAP_SCALE')

    try:
        georeference_map(source_raster, target_raster, tie_points, target_log,
                         target_crs=crs, source_crs=src_crs, map_scale=map_scale)
        print(f"OK: Georeferenced {Path(source_raster).name}")
        return 0
    except Exception as e:
        print(f"ERROR: Georeferencing {Path(source_raster).name}: {e}")
        print(f"       Run 'scons -k' to build the remaining maps despite this failure.")
        return 1


georef_action = Action(georef_builder, "Georeferencing $SOURCE",
                       varlist=['TARGET_CRS', 'SOURCE_CRS', 'MAP_SCALE'])
georef_builder_obj = Builder(action=georef_action)
env.Append(BUILDERS={'Georef': georef_builder_obj})


# ============================================================================
# FIND AND BUILD TARGETS FROM EXCEL
# ============================================================================

try:
    df = pd.read_excel(atlas_master, dtype={"Target crs": "string"})
    # Drop the stray index columns that pandas round-trips leave behind.
    df = df.loc[:, [c for c in df.columns if not str(c).startswith('Unnamed:')]]
    print(f"Loaded {atlas_master} with {len(df)} rows")
except Exception as e:
    print(f"ERROR: Could not load {atlas_master}: {e}")
    df = pd.DataFrame()

build_tasks = []
georef_nodes = []
bib_nodes = []

if not df.empty and 'tiepoint_path' in df.columns and 'raw_path' in df.columns:

    for idx, row in df.iterrows():
        tiepoint_paths = row['tiepoint_path']
        raw_paths = row['raw_path']

        if (pd.isna(tiepoint_paths) or str(tiepoint_paths).strip() in ('', '-')
                or pd.isna(raw_paths) or str(raw_paths).strip() in ('', '-')):
            continue

        target_crs = get_target_crs(row.get('Target crs'))

        tiepoint_list = [p.strip() for p in str(tiepoint_paths).split(',') if p.strip()]
        raw_list = [p.strip() for p in str(raw_paths).split(',') if p.strip()]

        if len(tiepoint_list) != len(raw_list):
            print(f"WARNING: Row {idx} has mismatched tiepoint/raw path counts "
                  f"({len(tiepoint_list)} vs {len(raw_list)})")
            continue

        for tiepoint_path, raw_path in zip(tiepoint_list, raw_list):
            tiepoint_path = Path(tiepoint_path)
            raw_path = Path(raw_path)

            if not tiepoint_path.exists():
                print(f"WARNING: Tiepoint file not found: {tiepoint_path}")
                continue

            if not raw_path.exists():
                print(f"WARNING: Raw raster file not found: {raw_path}")
                continue

            stem = tiepoint_path.stem

            # ---------------------------------------------------------------
            # The subdirectory for accessory files is named after the map stem
            # and sits alongside the georeferenced TIFF.
            # ---------------------------------------------------------------
            map_dir = tiepoint_path.parent.parent / stem
            os.makedirs(str(map_dir), exist_ok=True)

            target_tiff = tiepoint_path.parent.parent / f"{stem}.tiff"
            target_log = map_dir / f"{stem}.log"

            build_tasks.append({
                'tiepoint': str(tiepoint_path),
                'raw': str(raw_path),
                'target_log': str(target_log),
                'target_tiff': str(target_tiff),
                'map_dir': str(map_dir),
                'stem': stem,
                'target_crs': target_crs,
                'map_scale': safe_field(row.get('Scale', '')),
                'row_index': idx,
                'row': row,
            })

    print(f"\nFound {len(build_tasks)} georeferencing tasks from Excel")

    # Register all build targets — deduplicate by target_tiff path to
    # prevent "Two different environments" warnings when the same map
    # appears on multiple Excel rows (e.g. overlapping tiepoint entries).
    registered_targets = {}
    duplicate_report = {}
    used_cite_keys = {}

    for task in sorted(build_tasks, key=lambda x: x['stem']):

        target_key = task['target_tiff']
        if target_key in registered_targets:
            rows_seen = duplicate_report.setdefault(
                task['stem'], {registered_targets[target_key]})
            rows_seen.add(task['row_index'])
            continue
        registered_targets[target_key] = task['row_index']

        # --- Georeferencing target ---
        task_env = env.Clone()
        task_env['TARGET_CRS'] = task['target_crs']
        task_env['SOURCE_CRS'] = SOURCE_CRS
        task_env['MAP_SCALE'] = task['map_scale']

        georef_targets = task_env.Georef(
            [task['target_log'], task['target_tiff']],
            [task['tiepoint'], task['raw']]
        )
        georef_nodes.extend(list(georef_targets))

        # NOTE: deliberately NOT Depends(georef_targets, atlas_master).
        # A map's output depends on its tie points, its raw scan, and the two
        # spreadsheet values actually used (Target crs, Scale) — and those two
        # travel in the action's varlist, so changing either still rebuilds
        # exactly this map. Depending on the whole workbook meant editing any
        # single cell anywhere rebuilt all 497 maps.
        # ('scons --debug=explain' reported: rebuilding ... because
        # 'atlas_master.xlsx' changed.)

        # --- BibTeX generation target ---
        row = task['row']

        # Every plate row in atlas_master.xlsx belongs to Volume I; Volume II
        # is the text volume. (The old 'II' in raw_path test matched Roman
        # numeral map indices such as P_7_II.tiff.)
        cite_key, bib_entry = generate_map_bibtex(row, volume=ATLAS_VOLUME)

        # A single spreadsheet row can list several comma-separated maps, which
        # would otherwise share one cite key. Disambiguate with the map stem.
        if cite_key in used_cite_keys and used_cite_keys[cite_key] != task['stem']:
            unique_key = f"{cite_key}_{sanitise_key(task['stem'])}"
            bib_entry = bib_entry.replace(f"@incollection{{{cite_key},",
                                          f"@incollection{{{unique_key},", 1)
            print(f"INFO: Cite key {cite_key} reused by row {task['row_index']} "
                  f"→ {unique_key} for {task['stem']}")
            cite_key = unique_key
        used_cite_keys[cite_key] = task['stem']

        bib_path = str(Path(task['map_dir']) / f"{task['stem']}.bib")

        bib_env = env.Clone()
        bib_env['BIB_ENTRY'] = bib_entry

        # The source is the rendered entry itself, not the workbook, so a .bib
        # is rewritten only when that row's own metadata changes.
        bib_target = bib_env.BibTeX(
            target=bib_path,
            source=bib_env.Value(bib_entry)
        )
        bib_nodes.extend(list(bib_target))

    if duplicate_report:
        print(f"\nINFO: {len(duplicate_report)} map(s) appear on more than one row; "
              f"only the first is built:")
        for stem, rows in sorted(duplicate_report.items()):
            print(f"  {stem}: rows {sorted(rows)}")

else:
    print("ERROR: Could not find 'tiepoint_path' and/or 'raw_path' columns in Excel file")


# ============================================================================
# MASTER BibTeX FILE: atlas_antarktiki_maps.bib
# ============================================================================
# One entry per spreadsheet row (all row types), plus the parent @book entry.
# Saved to atlas/atlas_antarktiki_maps.bib
# Depends on all individual per-map .bib nodes so it is always consistent.
# ============================================================================

def master_bibtex_builder(target, source, env):
    """
    SCons builder that generates the master atlas_antarktiki_maps.bib.

    target[0]: atlas/atlas_antarktiki_maps.bib
    source[0]: atlas_master.xlsx
    source[1:]: all individual per-map .bib files (dependency chain)
    """
    master_path = str(target[0])

    try:
        df_master = pd.read_excel(str(source[0]), dtype={"Target crs": "string"})
        df_master = df_master.loc[
            :, [c for c in df_master.columns if not str(c).startswith('Unnamed:')]
        ]
    except Exception as e:
        print(f"ERROR: Could not read {source[0]} for master bib: {e}")
        return 1

    entries = []
    seen_keys = {}
    duplicates = 0

    for idx, row in df_master.iterrows():
        title = safe_field(row.get('Title', ''))
        if not title:
            continue
        try:
            cite_key, bib_entry = generate_bibtex_entry(row, volume=ATLAS_VOLUME)
        except Exception as e:
            print(f"WARNING: Row {idx} skipped in master bib: {e}")
            continue

        # BibTeX silently drops repeated keys, so disambiguate instead.
        if cite_key in seen_keys:
            duplicates += 1
            seen_keys[cite_key] += 1
            suffix = chr(ord('a') + seen_keys[cite_key] - 1)
            new_key = f"{cite_key}{suffix}"
            print(f"WARNING: Duplicate cite key {cite_key} at row {idx} → {new_key}")
            bib_entry = bib_entry.replace(f"@incollection{{{cite_key},",
                                          f"@incollection{{{new_key},", 1)
        else:
            seen_keys[cite_key] = 1

        entries.append(bib_entry)

    content = (
        f"% atlas_antarktiki_maps.bib\n"
        f"% Master bibliography — all atlas entries\n"
        f"% Auto-generated by SConstruct — {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n"
        f"% Entries: {len(entries)} (rows with a Title in {atlas_master})\n"
        f"% Duplicate keys disambiguated: {duplicates}\n\n"
        f"{ATLAS_PARENT_BIB}\n"
        + "\n\n".join(entries)
        + "\n"
    )

    os.makedirs(str(Path(master_path).parent), exist_ok=True)
    tmp_path = f"{master_path}.tmp"
    with open(tmp_path, 'w', encoding='utf-8') as f:
        f.write(content)
    os.replace(tmp_path, master_path)

    print(f"OK: Master bib written to {master_path} ({len(entries)} entries)")
    return 0


master_bib_action = Action(master_bibtex_builder, "Generating master BibTeX $TARGET")
master_bib_builder_obj = Builder(action=master_bib_action)
env.Append(BUILDERS={'MasterBibTeX': master_bib_builder_obj})

master_bib_target = Path('atlas') / 'atlas_antarktiki_maps.bib'
os.makedirs('atlas', exist_ok=True)

master_bib_node = env.MasterBibTeX(
    target=str(master_bib_target),
    source=[atlas_master] + bib_nodes
)
print(f"Configured master bib: {master_bib_target} "
      f"(depends on {len(bib_nodes)} individual bib files)")


# ============================================================================
# ALIASES
# ============================================================================

env.Alias('georef', georef_nodes)
env.Alias('bib', bib_nodes + list(master_bib_node))
env.Alias('pdf', compiled_pdfs)
env.Alias('images', image_nodes)

Default(georef_nodes + bib_nodes + list(master_bib_node) + image_nodes + compiled_pdfs)

print("\n" + "=" * 80)
print(f"georef: {len(georef_nodes)} node(s) | bib: {len(bib_nodes) + 1} | "
      f"images: {len(image_nodes)} | compiled pdf: {len(compiled_pdfs)}")
print(f"pdf output: {'colour' if PDF_COLOUR else 'grey'}, merged at "
      f"{PDF_MERGE_DPI} dpi / JPEG Q{PDF_MERGE_JPEG_QUALITY}")
print("Targets: scons | scons georef | scons bib | scons images | scons pdf")
print("         scons -k             keep building past a failing map")
print("=" * 80)
